BITRIX_WEBHOOK_URL="https://example.bitrix24.ru/rest/1/xxxxxxxxxxxxxxx/"

# Access policy: comma-separated subset of read,write,destructive,unknown
BITRIX_ALLOWED_ACCESS="read"
# Legacy shim (used only when BITRIX_ALLOWED_ACCESS is unset):
# BITRIX_READ_ONLY="true"
# BITRIX_ALLOW_UNKNOWN_METHODS="false"
# BITRIX_METHOD_CATALOG_PATH=""
# BITRIX_PORTAL_METHODS_TTL_SECONDS="3600"
# BITRIX_CRM_METADATA_TTL_SECONDS="604800"
# BITRIX_CRM_STATUSES_TTL_SECONDS="900"
BITRIX_REQUEST_TIMEOUT_SECONDS="20"

MCP_HOST="127.0.0.1"
MCP_PORT="8000"
MCP_TRANSPORT="streamable-http"
MCP_PATH="/mcp"
# Public origin (no path). Required with OAuth; MCP clients connect to <origin>/mcp.
MCP_PUBLIC_BASE_URL=""

LOGFIRE_ENABLED="true"
LOGFIRE_INSTRUMENT_HTTPX="false"
LOGFIRE_TOKEN="your-logfire-token"

# --- OAuth for MCP clients (Claude connectors) ---
# Without OAuth the endpoint is unauthenticated and runs as the webhook: local dev only.
# BITRIX_OAUTH_ENABLED="false"
# BITRIX_OAUTH_CLIENT_ID=""
# BITRIX_OAUTH_CLIENT_SECRET=""
# BITRIX_PORTAL_URL="https://example.bitrix24.ru"
# Audit log + pinned portal. OAuth proxy state defaults to <dir>/oauth-proxy.
# BITRIX_TOKEN_DB_PATH="./data/tokens.db"
# BITRIX_OAUTH_STORAGE_DIR=""
# Encrypts stored OAuth state.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BITRIX_TOKEN_ENCRYPTION_KEY=""
# Signs tokens issued to MCP clients. Defaults to a key derived from BITRIX_OAUTH_CLIENT_SECRET.
# MCP_JWT_SIGNING_KEY=""
# Restrict MCP client redirect URIs (comma-separated, wildcards allowed). Empty = any.
# MCP_ALLOWED_CLIENT_REDIRECT_URIS="https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback"
# BITRIX_ALLOW_WEBHOOK_WRITES="false"
# BITRIX_WRITE_OWNERSHIP="strict"
# BITRIX_OWNERSHIP_ADMIN_EMAILS=""
# BITRIX_TASK_OWNERSHIP_FIELDS="RESPONSIBLE_ID"
